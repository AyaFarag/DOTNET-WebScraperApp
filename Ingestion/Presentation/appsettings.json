{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scraper": {
    "Sources": [
      {
        "Name": "Site1",
        "IsEnabled": true,
        "Url": "https://site1.com/products",
        "ProductSelector": ".product",
        "PriceSelector": ".price"
      },
      {
        "Name": "Site2",
        "IsEnabled": true,
        "Url": "https://site2.com/prices",
        "ProductSelector": ".item-name",
        "PriceSelector": ".item-price"
      }
    ],
    "Headless": true,
    "Timeout": 30000
  }
}
